rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 공유 문서: 내용은 암호화되어 있고, 링크(문서 ID + 열쇠)를 가진 사람만 읽을 수 있음
    match /shares/{id} {
      function validShape() {
        let d = request.resource.data;
        return d.keys().hasOnly(['owner', 'v', 'iv', 'ct', 'updatedAt'])
          && d.owner == request.auth.uid
          && d.iv is string && d.iv.size() < 64
          && d.ct is string && d.ct.size() < 500000
          && d.updatedAt == request.time;
      }
      allow get: if true;            // ID를 알아야 읽을 수 있음 (목록 조회는 불가)
      allow list: if false;
      allow create: if request.auth != null && validShape();
      allow update: if request.auth != null && resource.data.owner == request.auth.uid && validShape();
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
